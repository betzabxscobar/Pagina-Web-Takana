{
  "name": "takana-neon-marketplace",
  "version": "1.0.0",
  "author": "Takana",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n WEB,API -c cyan,magenta \"vite --configLoader runner --host 127.0.0.1 --port 3100\" \"node --env-file-if-exists=.env --watch server/index.mjs --port 3101\"",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.mjs",
    "build": "tsc -b && vite build --configLoader runner",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run typecheck && npm run build",
    "test:smtp": "node --env-file-if-exists=.env scripts/test-smtp.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  }
}
