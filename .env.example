# Copia este archivo como .env y rellena los valores.
# .env esta ignorado por git: nunca se sube al repositorio.
# Los scripts npm lo cargan solos, no hace falta exportar nada a mano.

# --- Supabase --------------------------------------------------------------
# La anon key es publica por diseno. El navegador nunca habla directo con
# Supabase: todo pasa por /api, asi que estas dos solo las usa el servidor.
SUPABASE_URL=https://zfmbaemcczlpyzjyjeca.supabase.co
SUPABASE_ANON_KEY=

# Ignora RLS por completo. Solo servidor y scripts, JAMAS el navegador.
SUPABASE_SERVICE_ROLE=

# --- Correo ----------------------------------------------------------------
# Necesario para el cambio de contrasena con verificacion.
#
# Se usa un SMTP propio y no el de Supabase porque aquel exige permisos de
# administrador en el dashboard. Esta es una conexion SALIENTE: funciona desde
# un computador local, no hace falta servidor publico ni dominio.
#
# Gmail: activa la verificacion en dos pasos en tu cuenta de Google y crea una
# "contrasena de aplicacion" en myaccount.google.com/apppasswords. Esa clave de
# 16 letras va en SMTP_PASSWORD, no la contrasena normal del correo.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#
# Brevo (300 correos diarios gratis): las credenciales salen de
# app.brevo.com -> SMTP & API.
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Remitente que vera la gente. Si se deja vacio se usa SMTP_USER.
SMTP_FROM=

# Comprueba que quedo bien antes de probar desde la pagina:
#   npm run test:smtp -- tu@correo.com
