# Copiar a .env y rellenar. El archivo .env esta ignorado por git.
# La anon key es publica por diseno y puede ir al frontend.
VITE_SUPABASE_URL=https://zfmbaemcczlpyzjyjeca.supabase.co
VITE_SUPABASE_ANON_KEY=

# SOLO backend/scripts. Ignora RLS por completo: nunca exponerla al navegador.
SUPABASE_URL=https://zfmbaemcczlpyzjyjeca.supabase.co
SUPABASE_SERVICE_ROLE=

# Envio de correo propio, para el codigo de cambio de contrasena.
# Se usa un SMTP propio y no el de Supabase porque aquel es solo para pruebas
# y configurarlo exige permisos de administrador en el dashboard.
# Sirve cualquier proveedor: Gmail con contrasena de aplicacion, Brevo, Resend.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
